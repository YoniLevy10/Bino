    "@remotion/transitions": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@remotion/tailwind": "^4.0.0",
    "@types/react": "^18.3.12",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0"
  }
}
